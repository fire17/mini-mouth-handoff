+"""Detached Windows call ownership and local, generation-bound stop control."""
+from __future__ import annotations
+
+import argparse
+import contextlib
+import json
+import math
+import os
+from pathlib import Path
+import secrets
+import subprocess
+import sys
+import time
+
+STATE = "mini-mouth-supervisor.json"
+STOP = "mini-mouth-supervisor.stop.json"
+LOCK = "mini-mouth-supervisor.lock"
+RESTART = "mini-mouth-supervisor.restart.json"
+RESTART_CODE = 75
+
+
+def read_json(path):
+    try:
+        with Path(path).open("rb") as handle:
+            raw = handle.read(16385)
+        if len(raw) > 16384:
+            return None
+        row = json.loads(raw)
+        return row if isinstance(row, dict) else None
+    except (OSError, ValueError):
+        return None
+
+
+def write_json(path, row):
+    path = Path(path)
+    temporary = path.with_name(path.name + "." + secrets.token_hex(8) + ".tmp")
+    try:
+        with temporary.open("w", encoding="utf-8") as handle:
+            json.dump(row, handle)
+            handle.write("\n")
+            handle.flush()
+        for attempt in range(8):
+            try:
+                os.replace(temporary, path)
+                return
+            except PermissionError:
+                if attempt == 7:
+                    raise
+                time.sleep(.025)
+    finally:
+        try:
+            temporary.unlink()
+        except FileNotFoundError:
+            pass
+
+
+@contextlib.contextmanager
+def ownership_lock(runtime):
+    runtime = Path(runtime)
+    runtime.mkdir(parents=True, exist_ok=True)
+    handle = (runtime / LOCK).open("a+b")
+    try:
+        if handle.seek(0, os.SEEK_END) == 0:
+            handle.write(b"\0")
+            handle.flush()
+        handle.seek(0)
+        if sys.platform == "win32":
+            import msvcrt
+            msvcrt.locking(handle.fileno(), msvcrt.LK_NBLCK, 1)
+        else:
+            import fcntl
+            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        try:
+            yield
+        finally:
+            handle.seek(0)
+            if sys.platform == "win32":
+                msvcrt.locking(handle.fileno(), msvcrt.LK_UNLCK, 1)
+            else:
+                fcntl.flock(handle, fcntl.LOCK_UN)
+    finally:
+        handle.close()
+
+
+def is_locked(runtime):
+    try:
+        with ownership_lock(runtime):
+            return False
+    except (BlockingIOError, PermissionError):
+        return True
+    except OSError as error:
+        # msvcrt reports lock contention as EACCES/EDEADLK.
+        if error.errno in (11, 13, 36):
+            return True
+        raise
+
+
+def valid_owner(row):
+    return (isinstance(row, dict) and row.get("v") == 1
+            and isinstance(row.get("session"), str) and len(row["session"]) == 32
+            and all(c in "0123456789abcdef" for c in row["session"])
+            and isinstance(row.get("supervisorPid"), int) and row["supervisorPid"] > 0)
+
+
+def banner(runtime, row, reused=False):
+    print(f"mini-mouth: {'using existing' if reused else 'started'} background call; "
+          f"supervisor {row['supervisorPid']}, driver {row.get('driverPid')}; "
+          "closing this window does not stop the call.", flush=True)
+    print("Process startup is observed; wait for [configured] in the log or TUI before speaking.", flush=True)
+    print(f"Log: {Path(runtime) / 'mini-mouth-live.log'}\nStop the call: mm stop", flush=True)
+
+
+def start(runtime, *, dryrun=False, duration=0):
+    runtime = Path(runtime).resolve()
+    runtime.mkdir(parents=True, exist_ok=True)
+    previous = read_json(runtime / STATE)
+    locked = is_locked(runtime)
+    if locked and valid_owner(previous) and previous.get("phase") == "running":
+        banner(runtime, previous, reused=True)
+        return 0
+    if (not locked and valid_owner(previous)
+            and (previous.get("phase") in ("starting", "running")
+                 or previous.get("cleanupComplete") is False)):
+        print("mini-mouth: previous supervisor disappeared; its children have not been "
+              "confirmed stopped. Inspect the saved session and log before starting another call.", file=sys.stderr)
+        return 1
+    session = secrets.token_hex(16)
+    proc = None
+    if not locked:
+        arguments = [sys.executable, "-u", str(Path(__file__).resolve()), "serve",
+                     "--session", session, "--runtime-dir", str(runtime)]
+        if dryrun:
+            arguments += ["--dryrun", "--duration", str(duration)]
+        options = ({"creationflags": subprocess.DETACHED_PROCESS | subprocess.CREATE_NEW_PROCESS_GROUP}
+                   if sys.platform == "win32" else {"start_new_session": True})
+        with (runtime / "mini-mouth-live.log").open("ab", buffering=0) as log:
+            proc = subprocess.Popen(arguments, stdin=subprocess.DEVNULL, stdout=log,
+                                    stderr=log, close_fds=True, **options)
+    deadline = time.monotonic() + 30
+    while time.monotonic() < deadline:
+        row = read_json(runtime / STATE)
+        if valid_owner(row) and is_locked(runtime):
+            if row.get("phase") == "running":
+                banner(runtime, row, reused=row["session"] != session)
+                return 0
+        if valid_owner(row) and row.get("session") == session and row.get("phase") in ("stopped", "failed"):
+            print(f"mini-mouth: background startup ended ({row.get('exitCode')}); "
+                  f"see {runtime / 'mini-mouth-live.log'}", file=sys.stderr)
+            return row.get("exitCode") or 1
+        if proc is not None and proc.poll() is not None and not is_locked(runtime):
+            print(f"mini-mouth: background supervisor exited ({proc.returncode}); "
+                  f"see {runtime / 'mini-mouth-live.log'}", file=sys.stderr)
+            return proc.returncode or 1
+        time.sleep(.05)
+    print("mini-mouth: supervisor readiness was not observed within 30 seconds; "
+          f"inspect {runtime / STATE} and the log. No second driver was started.", file=sys.stderr)
+    return 1
+
+
+def stop(runtime, *, timeout=60):
+    runtime = Path(runtime).resolve()
+    owner = read_json(runtime / STATE)
+    if not is_locked(runtime):
+        if valid_owner(owner) and owner.get("phase") in ("starting", "running"):
+            print("mini-mouth: supervisor is absent; previous children are unconfirmed. "
+                  "No PID was killed from stale state.", file=sys.stderr)
+            return 1
+        if valid_owner(owner) and owner.get("phase") == "failed":
+            print("mini-mouth: previous session ended with a failure; inspect its log.", file=sys.stderr)
+            return owner.get("exitCode") or 1
+        print("mini-mouth: no supervised call is running.", flush=True)
+        return 0
+    if not valid_owner(owner):
+        print("mini-mouth: supervisor owner state is not readable; no stop was sent.", file=sys.stderr)
+        return 1
+    request = {"v": 1, "session": owner["session"], "supervisorPid": owner["supervisorPid"]}
+    write_json(runtime / STOP, request)
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        row = read_json(runtime / STATE)
+        if valid_owner(row) and row["session"] != owner["session"]:
+            print("mini-mouth: supervisor session changed; the replacement was not stopped.", file=sys.stderr)
+            return 1
+        if valid_owner(row) and row.get("phase") in ("stopped", "failed") and not is_locked(runtime):
+            code = row.get("exitCode") or 0
+            if row["phase"] == "stopped" and code == 0:
+                print("mini-mouth: call stopped; owned child cleanup completed.", flush=True)
+                return 0
+            print(f"mini-mouth: session ended with failure ({code or 1}); see its log.", file=sys.stderr)
+            return code or 1
+        time.sleep(.05)
+    print("mini-mouth: stop requested, but cleanup was not observed within the deadline; "
+          "inspect the session log.", file=sys.stderr)
+    return 1
+
+
+class Owner:
+    def __init__(self, runtime, session):
+        self.runtime = Path(runtime)
+        self.state = {"v": 1, "session": session, "supervisorPid": os.getpid(),
+                      "phase": "starting", "driverPid": None, "children": {}}
+        self.cleanup_failed = False
+        self.save()
+
+    def save(self):
+        self.state["updatedAt"] = time.time()
+        write_json(self.runtime / STATE, self.state)
+
+    def child_started(self, role, proc):
+        self.state["children"][role] = proc.pid
+        if role == "driver":
+            self.state["driverPid"] = proc.pid
+        self.save()
+
+    def ready(self):
+        self.state["phase"] = "running"
+        self.save()
+
+    def stop_requested(self):
+        row = read_json(self.runtime / STOP)
+        return bool(row and row.get("v") == 1 and row.get("session") == self.state["session"]
+                    and row.get("supervisorPid") == self.state["supervisorPid"])
+
+    def restart_crashes(self, proc):
+        """An exit code alone cannot request a restart; metadata binds the old child."""
+        if proc.returncode != RESTART_CODE:
+            return None
+        row = read_json(self.runtime / RESTART)
+        if (not row or row.get("v") != 1 or row.get("session") != self.state["session"]
+                or row.get("driverPid") != proc.pid):
+            return None
+        crashes = row.get("crashes")
+        if (not isinstance(crashes, list) or not 1 <= len(crashes) <= 100
+                or any(isinstance(value, bool) or not isinstance(value, (int, float))
+                       or not math.isfinite(value) for value in crashes)):
+            return None
+        # live.py has already applied the existing 2 s / 60 s backoff. Preserve
+        # that crash window and configuration in the next OWNED child.
+        if any(value > time.time() + 5 or value < time.time() - 190 for value in crashes):
+            return None
+        try:
+            (self.runtime / RESTART).unlink()
+        except OSError:
+            return None
+        return crashes
+
+    def finish(self, code):
+        self.state.update(phase="stopped" if code == 0 else "failed", exitCode=code,
+                          cleanupComplete=not self.cleanup_failed)
+        self.save()
+
+
+def request_restart(crashes):
+    """Called only by live.py's established recovery path under this supervisor."""
+    session = os.environ.get("MM_WINDOWS_SUPERVISOR_SESSION", "")
+    path = os.environ.get("MM_WINDOWS_SUPERVISOR_RESTART_PATH", "")
+    if len(session) != 32 or not path:
+        raise RuntimeError("supervised restart ownership metadata is missing")
+    write_json(path, {"v": 1, "session": session, "driverPid": os.getpid(),
+                      "crashes": crashes})
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("action", choices=("serve", "stop"))
+    parser.add_argument("--runtime-dir", type=Path, default=Path.home() / ".livemind")
+    parser.add_argument("--session")
+    parser.add_argument("--dryrun", action="store_true")
+    parser.add_argument("--duration", type=float, default=0)
+    args = parser.parse_args(argv)
+    if args.action == "stop":
+        return stop(args.runtime_dir)
+    if not args.session or len(args.session) != 32 or any(c not in "0123456789abcdef" for c in args.session):
+        parser.error("serve requires a session identifier from the launcher")
+    if sys.platform != "win32" and not args.dryrun:
+        parser.error("non-Windows fixtures require --dryrun")
+    try:
+        with ownership_lock(args.runtime_dir):
+            owner = Owner(args.runtime_dir, args.session)
+            import windows_launcher
+            forwarded = ["--runtime-dir", str(args.runtime_dir)]
+            if args.dryrun:
+                forwarded += ["--dryrun", "--duration", str(args.duration)]
+            result = windows_launcher.main(forwarded, owner=owner)
+            owner.finish(result)
+            return result
+    except (OSError, ValueError) as error:
+        print(f"mini-mouth: supervisor refused or failed: {error}", file=sys.stderr, flush=True)
+        return 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
