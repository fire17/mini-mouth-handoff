+def _win_read_key(timeout: float):
+    """Windows twin of tui_panels.read_key: one key NAME (same vocabulary) or None on timeout.
+    msvcrt delivers arrows/Home/End/Delete as a 0x00/0xE0 prefix + a code; ctrl-arrows likewise."""
+    import msvcrt
+    end = time.time() + timeout
+    while not msvcrt.kbhit():
+        if time.time() >= end:
+            return None
+        time.sleep(0.01)
+    ch = msvcrt.getwch()
+    if ch in ("\x00", "\xe0"):
+        code = msvcrt.getwch()
+        return {"H": "up", "P": "down", "M": "right", "K": "left", "G": "home", "O": "end", "S": "delete",
+                "s": "ctrl-left", "t": "ctrl-right", "\x8d": "ctrl-up", "\x91": "ctrl-down",
+                "w": "home", "u": "end", "R": "", "I": "", "Q": ""}.get(code, "")
+    if ch in ("\r", "\n"):
+        return "enter"
+    if ch in ("\x7f", "\x08"):
+        return "backspace"
+    if ch == "\t":
+        return "tab"
+    if ch == "\x03":
+        return "ctrl-c"
+    if ch == "\x1b":
+        return "esc"
+    try:
+        from tui_panels import _CTRL
+        named = _CTRL.get(ch.encode("latin-1", "ignore"))
+        if named:
+            return named
+    except Exception:
+        pass
+    return ch
+
+
+def _win_byte_reader():
+    """Bytes for tui_gaps.key_from_bytes on Windows (arrows arrive as CSI sequences)."""
+    import msvcrt
+    pending = []
+
+    def read():
+        if pending:
+            return pending.pop(0)
+        ch = msvcrt.getwch()
+        if ch in ("\x00", "\xe0"):
+            code = msvcrt.getwch()
+            seq = {"H": b"\x1b[A", "P": b"\x1b[B", "M": b"\x1b[C", "K": b"\x1b[D"}.get(code, b"")
+            if not seq:
+                return b""
+            pending.extend(bytes([b]) for b in seq[1:])
+            return seq[:1]
+        b = ch.encode("utf-8", "replace")
+        pending.extend(bytes([x]) for x in b[1:])
+        return b[:1]
+    return read
+
