+def _interrupt_self() -> None:
+    """Ctrl-C typed inside the TUI: run the SIGINT handler (cleanup + exit) on every platform."""
+    if _WIN:
+        import _thread
+        _thread.interrupt_main()          # raises the registered SIGINT handler in the main thread
+    else:
+        _os.kill(_os.getpid(), signal.SIGINT)
+
